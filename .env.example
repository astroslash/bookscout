# Required for live Google Books catalog requests (server-side only).
# Create a Google Cloud API key with the Books API enabled and restrict it to that API.
GOOGLE_BOOKS_API_KEY=

# Optional canonical origin for recommendation links. Defaults to the production Vercel URL.
# BOOK_BEACON_BASE_URL=https://k4connect.vercel.app

# Optional Amazon.com Associates tracking ID. No Amazon link appears without it.
# AMAZON_ASSOCIATES_TAG=yourtag-20
